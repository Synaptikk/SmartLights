<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Widget extension entitlements: the same App Group and keychain access group as the app
  (App/SmartLights.entitlements). No HomeKit: HomeKit calls fail in extensions (HMError 80);
  Apple Home actions run in the app process.
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.sinap.smartlights</string>
	</array>
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.sinap.smartlights</string>
	</array>
</dict>
</plist>
